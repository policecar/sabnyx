# sabnyx — copy to .env (gitignored). A real env var always beats this file.
# Full reference: docs/deployment.md "`.env` reference".

# Data repo (the vault). Unset = DATA_ROOT is this repo (single-repo layout).
SABNYX_DATA_DIR=~/sabnyx-vault
# Code checkout, read only by ops/scripts/sabnyx-sync-tend.sh (default ~/sabnyx).
#SABNYX_CODE_DIR=~/sabnyx

# LLM provider: anthropic (default) | moonshot | openrouter | openai-compatible
SABNYX_LLM_PROVIDER=moonshot
MOONSHOT_API_KEY=sk-...
#ANTHROPIC_API_KEY=sk-ant-...
#ANTHROPIC_AUTH_TOKEN=            # alternative to ANTHROPIC_API_KEY
#OPENROUTER_API_KEY=
#SABNYX_LLM_API_KEY=              # generic key for openai-compatible (fallback for the above)
#SABNYX_LLM_BASE_URL=             # required for openai-compatible
#SABNYX_MODEL_FAST=               # per-role model id overrides
#SABNYX_MODEL_STANDARD=
#SABNYX_MODEL_DEEP=
#SABNYX_MAX_LLM_CALLS=50          # tend's per-run call ceiling (0 = unlimited)
#SABNYX_LLM_MAX_RETRIES=3

# Telegram ingress (serve)
SABNYX_TELEGRAM_TOKEN=123456:ABC-DEF...
SABNYX_TELEGRAM_ALLOW=111111111,222222222   # trusted numeric sender IDs

# Rabbit R1 ingress (serve-http): comma-separated bearer keys
#SABNYX_R1_KEYS=

# Retrieval: grep (default) | vector
#SABNYX_RETRIEVER=grep
#SABNYX_EMBED_MODEL=

# source_agents trusted for unattended auto-promotion (default sabnyx-ingest)
#SABNYX_TRUSTED_SOURCES=sabnyx-ingest

